+    } }) };
+    return route.fulfill({ json: await overview(source, { query: url.searchParams.get('q') ?? '', view: url.searchParams.get('view') ?? 'all', offset: Number(url.searchParams.get('offset') ?? 0), limit: 100 }) });
+  });
