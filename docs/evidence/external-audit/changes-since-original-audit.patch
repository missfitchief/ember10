index 5c141c9..9fd545b 100644
--- a/apps/web/records.tsx
+++ b/apps/web/records.tsx
@@ -1,25 +1,28 @@
-import React,{useEffect,useState} from 'react';
+import React,{useEffect,useRef,useState} from 'react';
 import type { PublicOverview } from '../../packages/shared/public.js';
-import { api,dateTime,short,units,validPublicKey } from './view-model.js';
-import { creditState,ledgerConnection,transferUrl,uniqueReceipts,walletResult,type Credit,type Delivery,type Epoch,type EpochDetail,type Ledger,type LedgerAvailability,type PublicRecord,type WalletResult } from './ledger.js';
+import { accountingSol,api,dateTime,phaseLabel,payoutStatusLabel,settlementLabel,short,units,validPublicKey } from './view-model.js';
+import { creditState,epochPage,ledgerConnection,transferUrl,uniqueReceipts,walletResult,type Credit,type Delivery,type Epoch,type EpochDetail,type Ledger,type LedgerAvailability,type PublicRecord,type WalletResult } from './ledger.js';
 import { Allocation,Empty,Icon,Intro } from './components.js';
 
 export function CreditTable({rows,ledger}:{rows:Credit[];ledger:Ledger|null}) { return <div className="record-scroll"><table className="records-table"><caption className="sr">Exact credited and finalized reward units by asset</caption><thead><tr><th>Asset</th><th>Credited</th><th>Finalized delivery</th><th>Pending</th><th>Status</th></tr></thead><tbody>{rows.map(row=>{const asset=ledger?.assets.find(a=>a.mint===row.asset);return <tr key={row.asset}><td title={row.asset}><span className="token-title">{asset?.symbol??short(row.asset)}</span><code className="token-mint">{short(row.asset)}</code></td><td>{units(row.credited,asset?.decimals)}</td><td>{units(row.paid,asset?.decimals)}</td><td>{units(row.pending,asset?.decimals)}</td><td>{creditState(row)}</td></tr>;})}</tbody></table></div>; }
 function Receipt({receipt,cluster}:{receipt:Delivery;cluster?:string}) { const url=transferUrl(receipt.result?.signature,cluster);return <div className="receipt-row"><span>{short(receipt.asset)} <span className="status-small">{receipt.status.replaceAll('_',' ')}</span></span>{url?<a href={url} target="_blank" rel="noopener noreferrer">View transaction <Icon name="external"/></a>:<span className="muted">{receipt.result?.signature?'Recorded signature (network unverified)':'Finalized receipt not reported'}</span>}</div>; }
-export function EpochHistory({epochs,cluster}:{epochs:Epoch[];cluster?:string}) {
+export function EpochHistory({epochs,cluster,epochError,epochStatus,nextCursor,moreEpochs,moreBusy,retry}:{epochs:Epoch[];cluster?:string;epochError?:string;epochStatus?:string;nextCursor?:string|null;moreEpochs?:()=>void;moreBusy?:boolean;retry?:()=>void}) {
