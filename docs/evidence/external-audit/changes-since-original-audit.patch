+/* EMBER10 / Orbit — original presentation. Financial and selection policy live in the API. */
+:root{--bg:#fdfbf7;--panel:#fff;--panel2:#f7f1e9;--ink:#30251e;--muted:#817369;--subtle:#887b71;--line:#ebe4da;--line2:#dfd5c8;--accent:#d95028;--accentHover:#bd3b16;--teal:#397d60;--gold:#876c3e}
+body{background:var(--bg)}
+::selection{background:#ffccab;color:#422613}
+.site-header{background:#fdfbf7e8;border-bottom:1px solid #eee6db99;backdrop-filter:blur(20px)}
+.header-inner{max-width:1200px;min-height:82px;padding:0 36px;gap:32px}
+.brand{font-size:26px;gap:8px;letter-spacing:-1.5px}
+.brand em{color:var(--ink);font-weight:600}
+.brand-period{color:var(--accent)}
+.brand-flame{width:29px;height:35px;color:var(--accent);--flame-cutout:var(--bg)}
+.flame-icon{width:100%;height:100%}
+.desktop-navigation{margin:auto;gap:12px}
+.nav-item{font-size:13px;position:relative;font-weight:500;padding:10px 9px;color:#73685f;border-radius:0}
+.nav-item:hover,.nav-item.active{background:transparent;color:var(--ink)}
+.nav-item.active:after{position:absolute;content:'';height:3px;width:3px;border-radius:50%;background:var(--accent);bottom:4px;left:50%}
+.header-actions{gap:18px}.header-actions .pill{border:0;background:transparent;color:#8b7566;font-size:11px;padding:0}
+.header-actions .pill .dot{background:#e7864d;width:5px;height:5px;box-shadow:0 0 0 3px #e7864d15}
+.btn{border-radius:99px;font-weight:600;box-shadow:none;transition:background .2s,box-shadow .25s,transform .25s,border-color .2s;min-height:46px}
+.btn.small{padding:9px 18px}
