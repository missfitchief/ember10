# Safe by default. Copy to .env; never commit .env.
MODE=prelaunch
CLUSTER=localnet
DATABASE_URL=postgresql://ember5:local-development-only@127.0.0.1:55432/ember5_prelaunch
RPC_URL=http://127.0.0.1:8899
# SECONDARY_RPC_URL=https://your-independent-archive-provider
OUR_MINT=
OUR_POOL=
TREASURY=
OPERATIONS=
QUOTE_MINT=So11111111111111111111111111111111111111112
MASTER_PAUSE=true
BROADCAST_ENABLED=false
CENSUS_COMPLETE_CONTRACT=false
MAX_ROUND_LAMPORTS=1000000000
MAX_DAY_LAMPORTS=5000000000
MIN_RESERVE_LAMPORTS=100000000
MAX_TX_FEE_LAMPORTS=100000
API_PORT=4310
HOST=127.0.0.1
# JUPITER_API_KEY=
# OPERATOR_TOKEN=generate-at-least-32-random-characters-outside-chat
# SIGNER_URL=https://your-private-signer.example/sign
# SIGNER_TOKEN=
# APPROVAL_FILE=/run/secrets/pilot-approval.json
# SIGNER_FILE=allowed-only-for-explicit-test-chain-exercises
# Public web configuration never includes secrets. API_PROXY is a dev-server-only value.
